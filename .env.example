# 复制为 .env.local 后按需修改。所有变量名与 docs/TECH_DESIGN.md 3.5 节保持一致。

# --- v1 必需 ---
# canonical / sitemap / RSS / OG 图的绝对地址来源，禁止在代码里硬编码域名
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=你的名字

# --- v1 可选 ---
# 无 Cookie 分析平台（Umami / Vercel Analytics）的站点 ID，留空则不上报
NEXT_PUBLIC_ANALYTICS_ID=
# 本地预览草稿：true 时 draft: true 的文章也会出现在列表与构建产物中，生产环境必须为 false
CONTENT_INCLUDE_DRAFTS=false

# --- v2 才需要（引入后端 / 数据库后取消注释） ---
# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# RESEND_API_KEY=
# ADMIN_TOKEN=
